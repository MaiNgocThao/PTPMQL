@model Customer

<h2>Đơn hàng của @Model.Name</h2>

@foreach (var order in Model.Orders)
{
    <h4>Đơn hàng #@order.OrderId - @order.OrderDate</h4>

    <table class="table">
        <tr>
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Giá</th>
        </tr>

        @foreach (var item in order.OrderDetails)
        {
            <tr>
                <td>@item.Product.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.Price</td>
            </tr>
        }
    </table>
}